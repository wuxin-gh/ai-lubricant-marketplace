{
  "schema": "ai-lubricant.channel-template/v1",
  "id": "local.joyagent",
  "kind": "channel_template",
  "name": "joyagent",
  "display_name": "京东-joyagent",
  "summary": "由当前 ai-lubricant 渠道“京东-joyagent”导出的可移植配置模板",
  "publisher": "local-ai-lubricant",
  "category": "custom",
  "tags": [
    "备用"
  ],
  "icon": "",
  "version": "1.0.0",
  "status": "published",
  "resource": {
    "type": "channel_template",
    "channel": {
      "name": "京东-joyagent",
      "enabled": true,
      "base_url": "https://agentrs.jd.com/api/saas/openai-u",
      "billing_mode": "token",
      "timeout": 600,
      "retry_count": null,
      "extra_retry_status_codes": [],
      "chat_protocols": [
        {
          "enabled": true,
          "protocol": "openai",
          "path": "/v1/chat/completions",
          "upstream_stream": true,
          "client_preset": "none",
          "system_type": "auto",
          "send_reasoning_content": true,
          "models": []
        }
      ],
      "models_path": "/v1/models",
      "image_path": "/v1/images/generations",
      "video_path": "/v1/videos/generations",
      "speech_path": "/v1/audio/speech",
      "website_url": "https://joyagent.jd.com/pl/model-retrieval",
      "rate_limit": {
        "tpm_per_model": 0,
        "rpm_per_account": 0,
        "tpm_per_account": 0,
        "concurrent_per_account": 0
      },
      "auto_update_models": true,
      "model_id_rewrite_rules": []
    },
    "freeze_policy": {
      "enabled": true,
      "rules": [
        {
          "condition": "status_code",
          "key": "",
          "operator": "==",
          "value": "429",
          "enabled": true,
          "freeze_object": "account",
          "freeze_period": "seconds",
          "freeze_value": 60
        },
        {
          "condition": "exception",
          "key": "",
          "operator": "==",
          "value": "",
          "enabled": true,
          "freeze_object": "account",
          "freeze_period": "seconds",
          "freeze_value": 60
        }
      ]
    }
  }
}
