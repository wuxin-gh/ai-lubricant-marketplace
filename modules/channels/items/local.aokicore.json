{
  "schema": "model-api.channel-template/v1",
  "id": "local.aokicore",
  "kind": "channel_template",
  "name": "aokicore",
  "display_name": "AokiCore",
  "summary": "由当前 model-api 渠道“AokiCore”导出的可移植配置模板",
  "publisher": "local-model-api",
  "category": "custom",
  "tags": [
    "临时"
  ],
  "version": "1.0.0",
  "status": "published",
  "resource": {
    "type": "channel_template",
    "channel": {
      "name": "AokiCore",
      "enabled": false,
      "base_url": "https://ai.muapi.cn",
      "billing_mode": "token",
      "timeout": 600,
      "retry_count": 3,
      "extra_retry_status_codes": [],
      "chat_protocols": [
        {
          "enabled": true,
          "protocol": "openai",
          "path": "/v1/chat/completions",
          "upstream_stream": true,
          "client_preset": "none",
          "system_type": "auto",
          "send_reasoning_content": true,
          "models": []
        }
      ],
      "models_path": "/v1/models",
      "image_path": "/v1/images/generations",
      "video_path": "/v1/videos/generations",
      "speech_path": "",
      "rate_limit": {
        "status_codes": [],
        "tpm_per_model": 0,
        "rpm_per_account": 0,
        "tpm_per_account": 0,
        "cooldown_seconds": null,
        "concurrent_per_account": 0,
        "exception_cooldown_seconds": null
      },
      "auto_update_models": false
    },
    "freeze_policy": {
      "enabled": true,
      "rules": [
        {
          "condition": "status_code",
          "key": "",
          "operator": "==",
          "value": "429",
          "freeze_mode": "fixed_duration",
          "freeze_seconds": 60
        }
      ]
    }
  }
}
