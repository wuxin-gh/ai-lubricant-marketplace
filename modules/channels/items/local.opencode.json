{
  "schema": "ai-lubricant.channel-template/v1",
  "id": "local.opencode",
  "kind": "channel_template",
  "name": "opencode",
  "display_name": "OpenCode-Zen",
  "summary": "由当前 ai-lubricant 渠道“OpenCode-Zen”导出的可移植配置模板",
  "publisher": "local-ai-lubricant",
  "category": "custom",
  "tags": [
    "大服务商",
    "最新模型使用"
  ],
  "icon": "",
  "version": "1.0.0",
  "status": "published",
  "resource": {
    "type": "channel_template",
    "channel": {
      "name": "OpenCode-Zen",
      "enabled": true,
      "base_url": "https://opencode.ai/zen",
      "billing_mode": "token",
      "timeout": 600,
      "retry_count": 3,
      "extra_retry_status_codes": [],
      "chat_protocols": [
        {
          "enabled": true,
          "protocol": "openai",
          "path": "/v1/chat/completions",
          "upstream_stream": true,
          "client_preset": "none",
          "system_type": "auto",
          "send_reasoning_content": true,
          "models": []
        }
      ],
      "models_path": "/v1/models",
      "image_path": "/v1/images/generations",
      "video_path": "/v1/videos/generations",
      "speech_path": "",
      "website_url": "https://opencode.ai",
      "rate_limit": {
        "status_codes": [],
        "tpm_per_model": 0,
        "rpm_per_account": 0,
        "tpm_per_account": 0,
        "cooldown_seconds": null,
        "concurrent_per_account": 0
      },
      "auto_update_models": true,
      "model_id_rewrite_rules": [
        {
          "name": "",
          "enabled": true,
          "pattern": "[:-]free",
          "replacement": ""
        }
      ]
    },
    "freeze_policy": {
      "enabled": true,
      "rules": []
    }
  }
}
