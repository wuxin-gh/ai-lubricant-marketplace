{
  "schema": "ai-lubricant.channel-template/v1",
  "id": "local.aliyun-plan",
  "kind": "channel_template",
  "name": "aliyun-plan",
  "display_name": "aliyun",
  "summary": "由当前 ai-lubricant 渠道“aliyun”导出的可移植配置模板",
  "publisher": "local-ai-lubricant",
  "category": "custom",
  "tags": [
    "无可用账号"
  ],
  "icon": "",
  "version": "1.0.0",
  "status": "published",
  "resource": {
    "type": "channel_template",
    "channel": {
      "name": "aliyun",
      "enabled": true,
      "base_url": "https://coding.dashscope.aliyuncs.com/apps/anthropic",
      "billing_mode": "token",
      "timeout": 600,
      "retry_count": null,
      "extra_retry_status_codes": [],
      "chat_protocols": [
        {
          "enabled": true,
          "protocol": "anthropic",
          "path": "/v1/messages",
          "upstream_stream": true,
          "client_preset": "claude-code",
          "system_type": "auto",
          "send_reasoning_content": true,
          "models": []
        }
      ],
      "models_path": "/v1/models",
      "image_path": "/v1/images/generations",
      "video_path": "/v1/videos/generations",
      "speech_path": "",
      "website_url": "",
      "rate_limit": {
        "tpm_per_model": 0,
        "rpm_per_account": 0,
        "tpm_per_account": 0,
        "concurrent_per_account": 0
      },
      "auto_update_models": false,
      "model_id_rewrite_rules": []
    },
    "freeze_policy": {
      "enabled": true,
      "rules": [
        {
          "condition": "status_code",
          "key": "",
          "operator": "==",
          "value": "429",
          "enabled": true,
          "freeze_object": "account",
          "freeze_period": "seconds",
          "freeze_value": 60
        },
        {
          "condition": "status_code",
          "key": "",
          "operator": "==",
          "value": "401",
          "enabled": true,
          "freeze_object": "account",
          "freeze_period": "today",
          "freeze_value": 0
        }
      ]
    }
  }
}
