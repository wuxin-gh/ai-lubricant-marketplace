{
  "schema": "ai-lubricant.channel-template/v1",
  "id": "local.modelscope1",
  "kind": "channel_template",
  "name": "modelscope1",
  "display_name": "摸搭社区",
  "summary": "由当前 ai-lubricant 渠道“摸搭社区”导出的可移植配置模板",
  "publisher": "local-ai-lubricant",
  "category": "custom",
  "tags": [
    "每日用完"
  ],
  "icon": "",
  "version": "1.0.0",
  "status": "published",
  "resource": {
    "type": "channel_template",
    "channel": {
      "name": "摸搭社区",
      "enabled": true,
      "base_url": "https://api-inference.modelscope.cn",
      "billing_mode": "token",
      "timeout": 600,
      "retry_count": 2,
      "extra_retry_status_codes": [],
      "chat_protocols": [
        {
          "enabled": true,
          "protocol": "openai",
          "path": "/v1/chat/completions",
          "upstream_stream": true,
          "client_preset": "none",
          "system_type": "auto",
          "send_reasoning_content": true,
          "models": []
        }
      ],
      "models_path": "/v1/models",
      "image_path": "/v1/images/generations",
      "video_path": "/v1/videos/generations",
      "speech_path": "",
      "website_url": "https://modelscope.cn",
      "rate_limit": {
        "tpm_per_model": 0,
        "rpm_per_account": 0,
        "tpm_per_account": 0,
        "concurrent_per_account": 0
      },
      "auto_update_models": false,
      "model_id_rewrite_rules": []
    },
    "freeze_policy": {
      "enabled": true,
      "rules": [
        {
          "condition": "status_code",
          "key": "",
          "operator": "in",
          "value": "402",
          "enabled": true,
          "freeze_object": "account_model",
          "freeze_period": "minutes",
          "freeze_value": 1
        },
        {
          "condition": "exception",
          "key": "",
          "operator": "==",
          "value": "",
          "enabled": true,
          "freeze_object": "account",
          "freeze_period": "seconds",
          "freeze_value": 300
        },
        {
          "condition": "status_code",
          "key": "",
          "operator": "in",
          "value": "400",
          "enabled": true,
          "freeze_object": "account_model",
          "freeze_period": "seconds",
          "freeze_value": 1800
        },
        {
          "condition": "status_code",
          "key": "",
          "operator": "in",
          "value": "429",
          "enabled": true,
          "freeze_object": "account",
          "freeze_period": "minutes",
          "freeze_value": 10
        }
      ]
    }
  }
}
