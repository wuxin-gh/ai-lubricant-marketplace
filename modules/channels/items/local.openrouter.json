{
  "schema": "ai-lubricant.channel-template/v1",
  "id": "local.openrouter",
  "kind": "channel_template",
  "name": "openrouter",
  "display_name": "OpenRouter",
  "summary": "由当前 ai-lubricant 渠道“OpenRouter”导出的可移植配置模板",
  "publisher": "local-ai-lubricant",
  "category": "custom",
  "tags": [
    "每日用完"
  ],
  "icon": "",
  "version": "1.0.0",
  "status": "published",
  "resource": {
    "type": "channel_template",
    "channel": {
      "name": "OpenRouter",
      "enabled": true,
      "base_url": "https://openrouter.ai/api",
      "billing_mode": "token",
      "timeout": 120,
      "retry_count": null,
      "extra_retry_status_codes": [],
      "chat_protocols": [
        {
          "enabled": true,
          "protocol": "openai",
          "path": "/v1/chat/completions",
          "upstream_stream": "auto",
          "client_preset": "none",
          "system_type": "auto",
          "send_reasoning_content": true,
          "models": []
        }
      ],
      "models_path": "/v1/models",
      "image_path": "/v1/images/generations",
      "video_path": "/v1/videos/generations",
      "speech_path": "/v1/audio/speech",
      "website_url": "https://openrouter.ai",
      "rate_limit": {
        "tpm_per_model": 0,
        "rpm_per_account": 0,
        "tpm_per_account": 0,
        "concurrent_per_account": 0
      },
      "auto_update_models": true,
      "model_id_rewrite_rules": [
        {
          "name": "free",
          "enabled": true,
          "pattern": "[:-]free",
          "replacement": ""
        }
      ]
    },
    "freeze_policy": {
      "enabled": true,
      "rules": [
        {
          "condition": "status_code",
          "key": "",
          "operator": "==",
          "value": "403",
          "enabled": true,
          "freeze_object": "account",
          "freeze_period": "today",
          "freeze_value": 0
        },
        {
          "condition": "exception",
          "key": "",
          "operator": "==",
          "value": "",
          "enabled": true,
          "freeze_object": "account",
          "freeze_period": "seconds",
          "freeze_value": 60
        },
        {
          "condition": "status_code",
          "key": "",
          "operator": "==",
          "value": "429",
          "enabled": true,
          "freeze_object": "account",
          "freeze_period": "seconds",
          "freeze_value": 60
        },
        {
          "condition": "status_code",
          "key": "",
          "operator": "in",
          "value": "502,503,501,500",
          "enabled": true,
          "freeze_object": "channel",
          "freeze_period": "minutes",
          "freeze_value": 5
        }
      ]
    }
  }
}
