{
  "schema": "model-api.channel-template/v1",
  "id": "local.ark",
  "kind": "channel_template",
  "name": "ark",
  "display_name": "火山",
  "summary": "由当前 model-api 渠道“火山”导出的可移植配置模板",
  "publisher": "local-model-api",
  "category": "custom",
  "tags": [
    "火山"
  ],
  "version": "1.0.0",
  "status": "published",
  "resource": {
    "type": "channel_template",
    "channel": {
      "name": "火山",
      "enabled": true,
      "base_url": "https://ark.cn-beijing.volces.com/api",
      "billing_mode": "token",
      "timeout": 600,
      "retry_count": 3,
      "extra_retry_status_codes": [],
      "chat_protocols": [
        {
          "enabled": true,
          "protocol": "openai",
          "path": "/v3/chat/completions",
          "upstream_stream": true,
          "client_preset": "none",
          "system_type": "auto",
          "send_reasoning_content": true,
          "models": []
        }
      ],
      "models_path": "/v3/models",
      "image_path": "/v3/images/generations",
      "video_path": "/v3/videos/generations",
      "speech_path": "",
      "rate_limit": {
        "status_codes": [],
        "tpm_per_model": 0,
        "rpm_per_account": 0,
        "tpm_per_account": 0,
        "cooldown_seconds": null,
        "concurrent_per_account": 0,
        "exception_cooldown_seconds": null
      },
      "auto_update_models": false
    },
    "freeze_policy": {
      "enabled": true,
      "rules": [
        {
          "condition": "status_code",
          "key": "",
          "operator": "in",
          "value": "429",
          "freeze_mode": "fixed_duration",
          "freeze_seconds": 60
        }
      ]
    }
  }
}
