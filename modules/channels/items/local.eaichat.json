{
  "schema": "model-api.channel-template/v1",
  "id": "local.eaichat",
  "kind": "channel_template",
  "name": "eaichat",
  "display_name": "云智助手",
  "summary": "由当前 model-api 渠道“云智助手”导出的可移植配置模板",
  "publisher": "local-model-api",
  "category": "eaichat",
  "tags": [],
  "version": "1.0.0",
  "status": "published",
  "resource": {
    "type": "channel_template",
    "channel": {
      "name": "云智助手",
      "enabled": false,
      "base_url": "https://eaichat.ctyun.cn",
      "billing_mode": "token",
      "timeout": 600,
      "retry_count": null,
      "extra_retry_status_codes": [],
      "chat_protocols": [
        {
          "enabled": true,
          "protocol": "openai",
          "path": "/ai/portal/v3/openai/chat/completions",
          "upstream_stream": true,
          "client_preset": "none",
          "system_type": "auto",
          "send_reasoning_content": true,
          "models": []
        }
      ],
      "models_path": "/v1/models",
      "image_path": "/v1/images/generations",
      "video_path": "/v1/videos/generations",
      "speech_path": "",
      "rate_limit": {
        "concurrent_per_account": 0,
        "requests_per_minute_per_account": 30
      },
      "auto_update_models": true
    },
    "freeze_policy": {
      "enabled": true,
      "rules": []
    }
  }
}
