{
  "schema": "model-api.channel-template/v1",
  "id": "local.jiekou",
  "kind": "channel_template",
  "name": "jiekou",
  "display_name": "接口免费模型",
  "summary": "由当前 model-api 渠道“接口免费模型”导出的可移植配置模板",
  "publisher": "local-model-api",
  "category": "jiekou",
  "tags": [],
  "version": "1.0.0",
  "status": "published",
  "resource": {
    "type": "channel_template",
    "channel": {
      "name": "接口免费模型",
      "enabled": true,
      "base_url": "https://api.highwayapi.ai/openai",
      "billing_mode": "token",
      "timeout": 600,
      "retry_count": null,
      "extra_retry_status_codes": [],
      "chat_protocols": [
        {
          "enabled": true,
          "protocol": "openai",
          "path": "/v1/chat/completions",
          "upstream_stream": true,
          "client_preset": "none",
          "system_type": "auto",
          "send_reasoning_content": true,
          "models": []
        }
      ],
      "models_path": "/v1/free-trial/models",
      "image_path": "/v1/images/generations",
      "video_path": "/v1/videos/generations",
      "speech_path": "",
      "rate_limit": {
        "concurrent_per_account": 0,
        "requests_per_minute_per_account": 30
      },
      "auto_update_models": false
    },
    "freeze_policy": {
      "enabled": true,
      "rules": [
        {
          "condition": "status_code",
          "key": "",
          "operator": "==",
          "value": "429",
          "freeze_mode": "fixed_duration",
          "freeze_seconds": 60
        },
        {
          "condition": "status_code",
          "key": "",
          "operator": "in",
          "value": "403",
          "freeze_mode": "fixed_duration",
          "freeze_seconds": 60
        }
      ]
    }
  }
}
